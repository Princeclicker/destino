{
    "name": "spip/archiviste",
    "description": "Gérer des archives de fichiers Zip, Tar, ...",
    "license": "GPL-3.0-or-later",
    "type": "spip-plugin",
    "keywords": [
        "zip",
        "tar",
        "archives"
    ],
    "readme": "https://git.spip.net/spip/archiviste/src/branch/master/README.md",
    "authors": [
        {
            "name": "SPIP Team",
            "homepage": "https://discuter.spip.net/c/spip-dev/5",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://git.spip.net/spip/archiviste",
    "support": {
        "issues": "https://git.spip.net/spip/archiviste/issues"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-phar": "*",
        "ext-zip": "*",
        "ext-zlib": "*",
        "symfony/polyfill-php80": "^1.27",
        "symfony/polyfill-php81": "^1.27",
        "symfony/polyfill-php82": "^1.27"
    },
    "require-dev": {
        "spip-league/sdk": "^1.1"
    },
    "repositories": [
        {
            "name": "spip",
            "type": "composer",
            "url": "https://get.spip.net/composer"
        }
    ],
    "autoload": {
        "psr-4": {
            "Spip\\Archiver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spip\\Archiver\\Tests\\": "tests/"
        },
        "files": [
            "vendor/spip-league/sdk/src/Stub/functions.php"
        ]
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    },
    "scripts": {
        "analyse": "phpstan --memory-limit=1G",
        "baseline": "phpstan --memory-limit=1G --generate-baseline --allow-empty-baseline",
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --fix --ansi",
        "rector": "rector process --ansi",
        "rector-dry-run": "rector process --dry-run --ansi",
        "test": "phpunit --colors --no-coverage",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --colors"
    }
}
