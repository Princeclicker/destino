{
    "name": "spip-league/kernel",
    "description": "Noyau d'une application SPIP",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "kernel",
        "bootstrap"
    ],
    "authors": [
        {
            "name": "JamesRezo",
            "email": "james@rezo.net"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^5.4",
        "symfony/filesystem": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/var-dumper": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "SpipLeague\\Component\\Kernel\\": "src/"
        },
        "files": [
            "boot.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SpipLeague\\Test\\Component\\Kernel\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}
